   "outputs": [],
   "source": [
    "def maxProduct(n):\n",
    "    max1 = 0\n",
    "    max2 = 0\n",
    "    while n > 0:\n",
    "        num = n % 10\n",
    "        if num >= max1:\n",
    "            max2 = max1\n",
    "            max1 = num\n",
    "        elif num > max2:\n",
    "            max2 = num\n",
    "\n",
    "        n //= 10\n",
    "\n",
    "    return max1 * max2"
   ]
  },
