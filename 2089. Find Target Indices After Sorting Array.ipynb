   "source": [
    "def targetIndices(nums, target):\n",
    "    nums.sort()\n",
    "    res = []\n",
    "    n = len (nums)\n",
    "    \n",
    "    for i in range(n):\n",
    "        if nums[i] == target:\n",
    "            res.append(i)\n",
    "\n",
    "    return res"
   ]
  },
