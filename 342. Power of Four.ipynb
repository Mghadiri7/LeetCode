   "source": [
    "def isPowerOfFour(n):\n",
    "        if n < 1:\n",
    "            return False\n",
    "        while n >= 1:\n",
    "            if n == 1:\n",
    "                return True\n",
    "            elif n % 4 != 0:\n",
    "                return False\n",
    "            n /= 4\n",
    "        return False"
   ]
  },
