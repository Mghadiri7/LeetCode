   "source": [
    "def countBits(n):\n",
    "    ans = [0] * (n + 1)\n",
    "    for i in range(1, n+1):\n",
    "        ans[i] = ans[i >> 1] + (i & 1)\n",
    "    return ans"
   ]
  },
