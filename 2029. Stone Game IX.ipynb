   "source": [
    "def stoneGameIX(stones):\n",
    "    counts = [0, 0, 0]\n",
    "    for s in stones:\n",
    "        counts[s % 3] += 1\n",
    "\n",
    "    if counts[0] % 2 == 0:\n",
    "        return counts[1] > 0 and counts[2] > 0\n",
    "\n",
    "    else:\n",
    "        return abs(counts[1] - counts[2]) >= 3"
   ]
  },
