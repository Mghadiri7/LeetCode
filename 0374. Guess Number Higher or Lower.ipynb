   "source": [
    "def guessNumber(n):\n",
    "    L = 1\n",
    "    R = n\n",
    "    while L <= R:\n",
    "        mid = (L + R) // 2\n",
    "        res = guess(mid)\n",
    "        if res == 0:\n",
    "            return mid\n",
    "        elif res == -1:\n",
    "            R = mid - 1\n",
    "        else:\n",
    "            L = mid + 1"
   ]
  }
