   "source": [
    "def reverseBits(n):\n",
    "    bin_str = bin(n)\n",
    "    bin_str = bin_str[2:]\n",
    "    n = len(bin_str)\n",
    "    if n < 32:\n",
    "        bin_str = '0' * (32 - n) + bin_str\n",
    "    return int(bin_str[::-1], 2)"
   ]
  },
