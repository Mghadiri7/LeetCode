   "source": [
    "def titleToNumber(columnTitle):\n",
    "    n = len(columnTitle)\n",
    "    ans = 0\n",
    "    for i in range(n):\n",
    "        ans += (ord(columnTitle[-i-1]) - 64) * (26 ** i)\n",
    "    return ans"
   ]
  },
