   "source": [
    "from collections import Counter\n",
    "\n",
    "def majorityElement(nums):\n",
    "    _dict = Counter(nums)\n",
    "    return max(_dict, key = _dict.get)"
   ]
  },
  {
   "cell_type": "code",
