   "source": [
    "def checkDivisibility(n):\n",
    "    number = n\n",
    "    _sum = 0\n",
    "    _product = 1\n",
    "    while number > 0:\n",
    "        number, digit = divmod(number, 10)\n",
    "        _sum += digit\n",
    "        _product *= digit\n",
    "\n",
    "    return n % (_sum + _product) == 0"
   ]
  },
