   "source": [
    "def reverseDegree(s):\n",
    "    n = len(s)\n",
    "    ans = 0\n",
    "    for i in range(n):\n",
    "        ans += (123 - ord(s[i])) * (i + 1)\n",
    "\n",
    "    return ans"
   ]
