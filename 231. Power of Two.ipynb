   "source": [
    "def isPowerOfTwo(n):\n",
    "    if n < 1:\n",
    "        return False\n",
    "        \n",
    "    while n > 1:\n",
    "        n /= 2\n",
    "\n",
    "    if n == 1:\n",
    "        return True\n",
    "    return False"
   ]
  },
