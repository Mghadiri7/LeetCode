   "source": [
    "def concatenatedBinary(n):\n",
    "    res = 0\n",
    "    MOD = 10**9 + 7\n",
    "    for i in range(1, n+1):\n",
    "        res = (res << i.bit_length() | i) % MOD\n",
    "\n",
    "    return res % MOD"
   ]
  },
