   "source": [
    "def createGrid(m, n):\n",
    "    first = \".\" * n\n",
    "    other = \"#\" * (n - 1) + \".\"\n",
    "    res = [other] * (m - 1)\n",
    "    res.insert(0, first)\n",
    "    return res"
   ]
  },
