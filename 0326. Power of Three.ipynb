   "source": [
    "def isPowerOfThree(n):\n",
    "    if n < 1:\n",
    "        return False\n",
    "    while n >= 1:\n",
    "        if n == 1:\n",
    "            return True\n",
    "        elif n % 3 != 0:\n",
    "            return False\n",
    "        n /= 3\n",
    "    return False"
   ]
