   "source": [
    "def uniformArray(nums1):\n",
    "    if min(nums1) % 2 == 1:\n",
    "        return True\n",
    "    for x in nums1:\n",
    "        if x % 2 == 1:\n",
    "            return False\n",
    "    return True"
   ]
  },
