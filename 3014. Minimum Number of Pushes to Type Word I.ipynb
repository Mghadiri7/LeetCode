   "source": [
    "def minimumPushes(word):\n",
    "    n = len(word)\n",
    "    if n < 9:\n",
    "        return n\n",
    "    elif n < 17:\n",
    "        return 8 + (n - 8) * 2\n",
    "    elif n < 25:\n",
    "        return 24 + (n - 16) * 3\n",
    "    else:\n",
    "        return 48 + (n - 24) * 4"
   ]
  },
