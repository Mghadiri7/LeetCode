   "source": [
    "def maximumProduct(nums):\n",
    "    nums.sort()\n",
    "    first = nums[-1] * nums[-2] * nums[-3]\n",
    "    second = nums[0] * nums[1] * nums[-1]\n",
    "    return max(first, second)"
   ]
  },
