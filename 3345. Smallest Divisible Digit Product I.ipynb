   "source": [
    "def smallestNumber(n, t):\n",
    "    for i in range(n, n+10):\n",
    "        ans = i\n",
    "        product = 1\n",
    "        while i > 0:\n",
    "            product *= i % 10\n",
    "            i //= 10\n",
    "        if product % t == 0:\n",
    "            return ans"
   ]
  },
