   "outputs": [],
   "source": [
    "def isSubsequence(s, t):\n",
    "    p_s, p_t = 0, 0\n",
    "    n = len(s)\n",
    "    while p_s < n and p_t < len(t):\n",
    "        if s[p_s] == t[p_t]:\n",
    "            p_s += 1\n",
    "        p_t += 1\n",
    "    return p_s == n"
   ]
  },
