   "outputs": [],
   "source": [
    "def countCommas(n):\n",
    "    ans = 0\n",
    "    power_1000 = 1000\n",
    "    while n >= power_1000:\n",
    "        ans += n - power_1000 + 1\n",
    "        power_1000 *= 1000\n",
    "\n",
    "    return ans"
   ]
  },
