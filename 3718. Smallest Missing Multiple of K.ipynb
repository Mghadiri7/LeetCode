   "source": [
    "def missingMultiple(nums, k):\n",
    "    _set = set(nums)\n",
    "    i = 1\n",
    "    while True:\n",
    "        if k * i not in _set:\n",
    "            return k * i\n",
    "\n",
    "        i += 1"
   ]
  },
