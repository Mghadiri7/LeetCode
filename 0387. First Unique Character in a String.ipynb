   "source": [
    "from collections import Counter\n",
    "\n",
    "def firstUniqChar(s):\n",
    "    freq = Counter(s)\n",
    "    n = len(s)\n",
    "    for i in range(n):\n",
    "        if freq[s[i]] == 1:\n",
    "            return i\n",
    "    return -1"
   ]
  },
