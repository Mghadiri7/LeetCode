   "source": [
    "import math\n",
    "\n",
    "def numberOfSets(n, k):\n",
    "    MOD = 10**9 + 7\n",
    "    ans = math.comb(n + k -1, 2 * k)\n",
    "    return ans % MOD"
   ]
  },
