   "source": [
    "def sumOfSquares(nums):\n",
    "    n = len(nums)\n",
    "    res = 0\n",
    "    for i in range(n):\n",
    "        if n % (i + 1) == 0:\n",
    "           res += nums[i] ** 2\n",
    "\n",
    "    return res"
   ]
  },
